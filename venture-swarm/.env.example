## Shared
# Local SDK-compatible directory/registry endpoint.
DIRECTORY_URL=http://localhost:8000
ZYND_REGISTRY_URL=http://localhost:8000
# For public ZNS deployment, each agent should set SERVICE_URL to its public HTTPS base URL.
# SERVICE_URL=https://your-public-agent-host
LOG_LEVEL=INFO

## Zynd Naming Service
ZNS_ROOT=zns01.zynd.ai
ZNS_DEVELOPER_HANDLE=venture-swarm

## Live LLM reasoning
# Copy this file to .env and put real keys there.
# Never commit real API keys to .env.example.
# Supported values: none, openai, groq, gemini, anthropic, mistral, cerebras
LLM_PROVIDER=none
LLM_TIMEOUT_S=20
LLM_MAX_ITEMS=5

## Apify real web data enrichment
APIFY_ENABLED=false
APIFY_API_TOKEN=
APIFY_MAX_ITEMS=5
APIFY_TIMEOUT_S=20
APIFY_CACHE_TTL_S=600
APIFY_GOOGLE_SEARCH_ACTOR=apify/google-search-scraper
APIFY_GOOGLE_NEWS_ACTOR=apify/google-news-scraper
APIFY_REDDIT_ACTOR=trudax/reddit-scraper

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Mistral
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=mistral-small-latest

# Cerebras
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=llama3.1-8b

## Orchestrator
ORCHESTRATOR_PORT=8001
ORCHESTRATOR_SDK_WEBHOOK_PORT=9201

## Premium agent flow (optional)
# Legacy local fallback: if set and X402_ENABLED=false, orchestrator will attach
# this token to retry 402 Payment Required agents.
PREMIUM_PAYMENT_TOKEN=

# Optional premium benchmarking agent toggle
BENCHMARK_PREMIUM_REQUIRED=false
BENCHMARK_PREMIUM_COST_USD=0.15

## x402 / Base Sepolia showcase (optional)
# The SDK derives the EVM wallet from each agent's Ed25519 identity.
# Fund the logged wallet address with Base Sepolia ETH and Base Sepolia USDC.
X402_ENABLED=false
X402_NETWORK=eip155:84532
X402_NETWORK_NAME=Base Sepolia
X402_USDC_ASSET=0x036CbD53842c5426634e7929541eC2318f3dCF7e
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_SYNC_FACILITATOR_ON_START=true

## Agent key material (optional overrides)
# ZYND_AGENT_KEYPAIR_PATH=.keys/agent.key

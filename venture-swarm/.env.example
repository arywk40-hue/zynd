## Shared
# Local SDK-compatible directory/registry endpoint.
DIRECTORY_URL=http://localhost:8000
ZYND_REGISTRY_URL=http://localhost:8000
LOG_LEVEL=INFO

## Live LLM reasoning
# Copy this file to .env and put real keys there.
# Never commit real API keys to .env.example.
# Supported values: none, openai, groq, gemini, anthropic, mistral, cerebras
LLM_PROVIDER=none
LLM_TIMEOUT_S=20
LLM_MAX_ITEMS=5

# Groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Mistral
MISTRAL_API_KEY=EhMifSryuFWQXBhAYstSTksx9dsGVH1p
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=mistral-small-latest

# Cerebras
CEREBRAS_API_KEY=csk-yph5m82kxvhrcpp59d3cc4xp8kn9e498npekkejpynxfv933
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=llama3.1-8b

## Orchestrator
ORCHESTRATOR_PORT=8001
ORCHESTRATOR_SDK_WEBHOOK_PORT=9201

## Premium agent flow (optional)
# If set, orchestrator will attach this token to retry 402 Payment Required agents.
PREMIUM_PAYMENT_TOKEN=

## Agent key material (optional overrides)
# ZYND_AGENT_KEYPAIR_PATH=.keys/agent.key
